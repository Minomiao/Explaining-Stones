<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExplainingStones.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Explaining Stones - 设置">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 沉浸式标题栏：内容延伸到标题栏区域，本行作为窗口拖动区域 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" x:Name="RightPaddingColumn" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="设置"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- 左侧导航：音乐 / 音效 -->
        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="152"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        AlwaysShowHeader="False"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="音乐" Tag="music" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="音效" Tag="sound">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="MusicPage" Padding="24">
                    <StackPanel Spacing="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                                <TextBlock Text="播放列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="BrowseButton" Grid.Column="1" MinWidth="96">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="添加…" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 播放列表：纯白底，边缘用多层半透明描边做出内凹阴影 -->
                        <Border Background="White" CornerRadius="8" RequestedTheme="Light">
                            <Border BorderThickness="1" BorderBrush="#33000000" CornerRadius="8" Padding="1">
                                <Border BorderThickness="1" BorderBrush="#1A000000" CornerRadius="7" Padding="1">
                                    <Border BorderThickness="1" BorderBrush="#0D000000" CornerRadius="6">
                                        <StackPanel x:Name="PlaylistPanel" Spacing="6" Margin="12,10,12,10" />
                                    </Border>
                                </Border>
                            </Border>
                        </Border>

                        <TextBlock Text="打开文件即加入列表；条目可删除或设为单曲循环。点击桌宠播放 / 暂停。"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SoundPage" Padding="24" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <CheckBox x:Name="CrackleCheck">
                            <TextBlock Text="爆豆声" VerticalAlignment="Center" />
                        </CheckBox>

                        <CheckBox x:Name="HissCheck">
                            <TextBlock Text="老式收音机声" VerticalAlignment="Center" />
                        </CheckBox>

                        <CheckBox x:Name="StereoCheck">
                            <TextBlock x:Name="StereoLabel" Text="立体声" VerticalAlignment="Center" />
                        </CheckBox>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                            <TextBlock Text="三维声源位置" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="左右 X（-1 左 ~ 1 右）" Opacity="0.7" />
                                <Slider x:Name="XSlider" Minimum="-1" Maximum="1" StepFrequency="0.01" />
                                <TextBlock Text="上下 Y（-1 下 ~ 1 上）" Opacity="0.7" />
                                <Slider x:Name="YSlider" Minimum="-1" Maximum="1" StepFrequency="0.01" />
                                <TextBlock Text="远近 Z（0 屏幕平面 ~ 1 最远）" Opacity="0.7" />
                                <Slider x:Name="ZSlider" Minimum="0" Maximum="1" StepFrequency="0.01" />
                            </StackPanel>

                            <!-- 斜 45° 视角：正面矩形是屏幕（平视面），空间向远处延伸，圆点是声源 -->
                            <Border Grid.Column="1"
                                    Width="220"
                                    Height="170"
                                    BorderThickness="1"
                                    BorderBrush="Gray"
                                    CornerRadius="6">
                                <Canvas x:Name="SpatialView" Width="220" Height="170" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
