<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExplainingStones.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Explaining Stones - 设置">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 沉浸式标题栏：内容延伸到标题栏区域，本行作为窗口拖动区域 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" x:Name="RightPaddingColumn" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="设置"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="14" Padding="24">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                <TextBlock Text="音乐文件位置" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox"
                         PlaceholderText="音乐文件路径（mp3 / wav / m4a / flac）" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        MinWidth="96">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                        <TextBlock Text="浏览…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Text="选择音乐文件后点击保存，点击桌宠即可播放 / 暂停。"
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <CheckBox x:Name="NoiseCheck">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                    <TextBlock Text="叠加老式播放器噪音（底噪 / 爆豆声）" VerticalAlignment="Center" />
                </StackPanel>
            </CheckBox>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                <TextBlock Text="三维声源位置" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="左右 X（-1 左 ~ 1 右）" Opacity="0.7" />
                    <Slider x:Name="XSlider" Minimum="-1" Maximum="1" StepFrequency="0.01" />
                    <TextBlock Text="上下 Y（-1 下 ~ 1 上）" Opacity="0.7" />
                    <Slider x:Name="YSlider" Minimum="-1" Maximum="1" StepFrequency="0.01" />
                    <TextBlock Text="远近 Z（0 屏幕平面 ~ 1 最远）" Opacity="0.7" />
                    <Slider x:Name="ZSlider" Minimum="0" Maximum="1" StepFrequency="0.01" />
                </StackPanel>

                <!-- 斜 45° 视角：正面矩形是屏幕（平视面），空间向远处延伸，圆点是声源 -->
                <Border Grid.Column="1"
                        Width="220"
                        Height="170"
                        BorderThickness="1"
                        BorderBrush="Gray"
                        CornerRadius="6">
                    <Canvas x:Name="SpatialView" Width="220" Height="170" />
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                        MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
