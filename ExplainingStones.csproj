<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ExplainingStones</RootNamespace>
    <AssemblyName>Explaining Stones</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWinUI>true</UseWinUI>
    <!-- 应用程序清单：声明支持的 Windows 版本（DPI 感知在 Program.Main 中设置） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 图标，由 Assets/icons/app.svg 渲染生成 -->
    <ApplicationIcon>Stone.ico</ApplicationIcon>
    <!-- 默认以非打包方式运行，便于开发调试；生成商店包时传 -p:Packaged=true -->
    <WindowsPackageType Condition="'$(Packaged)' != 'true'">None</WindowsPackageType>
    <!-- 启用 MSIX 打包工具链（清单设计器与打包目标），仅打包时需要 -->
    <EnableMsixTooling Condition="'$(Packaged)' == 'true'">true</EnableMsixTooling>
    <!-- 商店提交不需要符号包；生成符号包依赖 VS 的 mspdbcmf.exe，缺失会导致打包报错 -->
    <AppxSymbolPackageEnabled Condition="'$(Packaged)' == 'true'">false</AppxSymbolPackageEnabled>
    <!-- 包资源默认语言设为中文，使清单声明 zh-CN 而非默认的 en-US -->
    <DefaultLanguage Condition="'$(Packaged)' == 'true'">zh-CN</DefaultLanguage>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 入口点由 Program.Main 提供（WinForms 消息循环），禁用 XAML 生成的 Main -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- 本项目不使用 WPF，跳过 WindowsDesktop SDK 引入的 WPF XAML 编译器，
         否则它会和 WinUI 的 XAML 编译器抢同一批 Page/ApplicationDefinition 项 -->
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘图标源文件：嵌入程序集，运行时由 SvgIcons 渲染 -->
    <EmbeddedResource Include="Assets\icons\*.svg" />
  </ItemGroup>

  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <!-- MSIX 包清单：磁贴与启动图资源由 Assets/icons/app.svg 渲染生成 -->
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <!-- Stone.png 与磁贴图会被 WinUI 目标隐式归为 Content，必须显式声明随发布输出。
         只写 CopyToOutputDirectory 的话 build 有、publish 没有，免安装版会缺图 -->
    <Content Update="Stone.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="theme.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
